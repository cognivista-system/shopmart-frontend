# ─────────────────────────────────────────────────────────────
# Demo mode (default): run the whole app on local mock data,
# with NO backend/API calls — perfect for localhost dev & demos.
VITE_DEMO_MODE=true
# ─────────────────────────────────────────────────────────────
# To use the real backend instead, set VITE_DEMO_MODE=false and:
#   DEV  -> keep VITE_API_BASE_URL=/api; the Vite dev proxy forwards
#           /api/* to VITE_API_TARGET (no CORS needed).
#   PROD -> set VITE_API_BASE_URL to the full backend URL incl. /api,
#           e.g. https://shopmart-backend-production.up.railway.app/api
VITE_API_BASE_URL=/api
VITE_API_TARGET=https://shopmart-backend-production.up.railway.app
